# ============================================================================
# Backend environment configuration — EXAMPLE
# ----------------------------------------------------------------------------
# Copy this file to `backend/.env` and fill in real values.
#   cp backend/.env.example backend/.env
# `backend/.env` is git-ignored — never commit real credentials.
# All variables below are read in backend/backend/settings.py (and
# backend/chatbot/views.py for GROQ_API_KEY).
# ============================================================================

# ─── Django core ────────────────────────────────────────────────────────────
# Required whenever DEBUG=False. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-50-character-random-string

# "true" for local development, "false" for production.
# When false, Django also enables SSL redirect, HSTS and secure cookies.
DEBUG=true

# Comma-separated. Optional — falls back to
# localhost,127.0.0.1,.up.railway.app when unset.
# ALLOWED_HOSTS=localhost,127.0.0.1,your-backend.up.railway.app


# ─── Database ───────────────────────────────────────────────────────────────
# Resolution order in settings.py:
#   1. DATABASE_URL   (single connection string — preferred in production)
#   2. DB_PASSWORD    (discrete Neon/PostgreSQL fields below)
#   3. SQLite fallback at backend/db.sqlite3
#
# Option 1 — connection string (Railway / Render / Neon pooled URL):
# DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require
#
# Option 2 — discrete fields (Neon serverless PostgreSQL):
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=your-neon-password
DB_HOST=ep-xxxx-pooler.region.aws.neon.tech
DB_PORT=5432


# ─── Chatbot (ARIA) ─────────────────────────────────────────────────────────
# Groq Cloud API key — free tier at https://console.groq.com
# Without it, GET /api/chatbot/ reports "unavailable" and the widget shows a
# setup hint instead of crashing.
# Accepted aliases: GROQ_API_KEY, GROQ_KEY, CHATBOT_GROQ_API_KEY, GROQ_TOKEN
GROQ_API_KEY=gsk_your_groq_api_key_here


# ─── CORS / CSRF ────────────────────────────────────────────────────────────
# Comma-separated origins. Both are optional — sensible localhost + deployed
# defaults are applied in settings.py when unset.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
# CSRF_TRUSTED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
