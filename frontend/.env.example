# ============================================================================
# Frontend environment configuration — EXAMPLE
# ----------------------------------------------------------------------------
# Copy to `frontend/.env` (local) or set in the Vercel dashboard (production).
#   cp frontend/.env.example frontend/.env
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# ============================================================================

# Base URL of the Django API, including the trailing /api segment.
#
# LOCAL DEVELOPMENT: leave this unset. frontend/src/services/api.js falls back
# to the relative path "/api", which vite.config.js proxies to
# http://localhost:8000 — no CORS setup required.
#
# PRODUCTION: point at the deployed backend.
# VITE_API_URL=https://your-backend.up.railway.app/api
